  "fish": [
    {
      "id": "sardines",
      "localName": "Salinas / Tunsoy",
      "identification": "Sardines • Sardinella spp.",
      "habitat": "Schools in coastal seawater, swimming in the water column rather than living on the seabed.",
      "note": "Salinas and Tunsoy are overlapping local names for different sardines. Cavite reports tunsoy; the exact species at this pin needs identification.",
      "source": {
        "title": "FAO — sardine habitat",
        "url": "https://www.fao.org/4/ac482e/ac482e18.pdf"
      }
    },
    {
      "id": "indian-mackerel",
      "localName": "Kabayas / Alumahan",
      "identification": "Indian mackerel • Rastrelliger kanagurta",
      "habitat": "Swims in large schools in coastal open water. Young fish eat phytoplankton; adults eat larger plankton, including fish and shrimp larvae.",
      "source": {
        "title": "FAO — Indian mackerel habitat",
        "url": "https://www.fao.org/4/ad471e/ad471e55.pdf"
      }
    },
    {
      "id": "anchovies",
      "localName": "Dilis",
      "identification": "Anchovies • Stolephorus spp.",
      "habitat": "Small fish living in the water column of coastal waters; several species form schools.",
      "source": {
        "title": "FAO — coastal anchovies",
        "url": "https://www.fao.org/4/i2741e/i2741e10a.pdf"
      }
    },
    {
      "id": "ponyfish",
      "localName": "Sapsap",
      "identification": "Slipmouths / ponyfish • Leiognathidae",
      "habitat": "Generally lives near the seabed in shallow coastal waters over sand or mud. Habitat varies among ponyfish species.",
      "source": {
        "title": "Research field guide — ponyfish habitats",
        "url": "https://www.museum.kagoshima-u.ac.jp/staff/motomura/2021_01_BidongFishes.pdf"
      }
    },
    {
      "id": "threadfin-bream",
      "localName": "Bisugo",
      "identification": "Threadfin breams • Nemipterus spp.",
      "habitat": "Lives near sandy or muddy seabeds in coastal marine waters. The different species occupy different depths.",
      "source": {
        "title": "Philippine fish field guide — threadfin breams",
        "url": "https://www.museum.kagoshima-u.ac.jp/publications/pdf_images/PhilippineFG_lowres.pdf"
      }
    },
    {
      "id": "hairtail",
      "localName": "Espada",
      "identification": "Hairtails / cutlassfish • Trichiurus spp.",
      "habitat": "Swims near the seabed and in the water above it over the continental shelf. Some occur in shallow coastal water over mud.",
      "source": {
        "title": "FAO — hairtail habitat",
        "url": "https://www.fao.org/4/x3478e/x3478e14.pdf"
      }
    }
  ],
